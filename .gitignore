# siRecords: redistribution rights unresolved (recovered via Internet Archive,
# not the authors' sanctioned academic-request channel) -- kept locally for
# reference but never committed. See NOTICE.md / data/sirecords_overlap_analysis.md.
data/raw/sirecords_efficacy.csv
